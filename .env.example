# Lokales Sprachmodell
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_FAST_MODEL=qwen3.5:9b
OLLAMA_REQUEST_TIMEOUT_SECONDS=180

# Embeddings (v1.2): ollama für den echten Betrieb, hashing nur für schnelle Tests.
# Einmal laden: ollama pull qwen3-embedding:0.6b ; danach Index bauen: novabank-index neu-aufbauen
EMBEDDING_BACKEND=ollama
EMBEDDING_MODEL=qwen3-embedding:0.6b
ROUTER_MODE=hybrid
# Optional; Standard ist <RUNTIME_DIR>/index
# INDEX_DIR=/absoluter/pfad/zum/index

# Antworterzeugung
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024
LLM_CONTEXT_TOKENS=8192
ANSWER_MAX_ATTEMPTS=2
OLLAMA_THINK=false
MCP_REQUEST_TIMEOUT_SECONDS=30

# MCP-Transport (v1.5): stdio startet pro Anfrage einen Unterprozess; http spricht mit einem
# eigenen Streamable-HTTP-Server (Start: novabank-mcp --transport http).
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=8001
MCP_SERVER_URL=http://127.0.0.1:8001/mcp
# Tokens für den MCP-Server haben eine eigene Audience und eine kurze Laufzeit.
MCP_AUDIENCE=novabank-mcp
MCP_TOKEN_TTL_MINUTES=5
# Optional; Standard ist das Verzeichnis des Betriebssystems für Anwendungsdaten des Benutzers.
# RUNTIME_DIR=/absoluter/pfad/zu/lokalen/laufzeitdaten

# API und Sicherheit (v1.3)
# Pflicht für die API. Einmal erzeugen und nie ins Repository legen:
#   python -c 'import secrets; print(secrets.token_urlsafe(48))'
JWT_SECRET=
JWT_TTL_MINUTES=15
API_HOST=127.0.0.1
API_PORT=8000
API_BASE_URL=http://127.0.0.1:8000
# JSON-Liste, z. B. ["https://intranet.example"]; leer = kein Zugriff von anderen Ursprüngen.
CORS_ALLOWED_ORIGINS=[]
LOGIN_RATE_LIMIT_PER_MINUTE=5
CHAT_RATE_LIMIT_PER_MINUTE=20
API_DOCS_ENABLED=true
# Benutzer: novabank-users anlegen <name> --rolle sachbearbeiter|pruefer|admin [--team team-nord]

# Anwendung
APP_ENV=development
LOG_LEVEL=INFO
UI_SERVER_NAME=127.0.0.1
UI_SERVER_PORT=7860

# Beobachtbarkeit (v1.6): Langfuse, standardmäßig aus. Selbst betreiben mit
#   python scripts/langfuse_env.py && make langfuse-up
# und die ausgegebenen Schlüssel hier eintragen. Solange LANGFUSE_ENABLED=false ist, wird nichts gesendet.
LANGFUSE_ENABLED=false
LANGFUSE_BASE_URL=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_PSEUDONYMIZE_USERS=true
# Angenommener Preis für die Kostenansicht (Langfuse zeigt USD). Lokale Modelle kosten keine API-Gebühren.
LLM_PRICE_INPUT_PER_MILLION_TOKENS=0
LLM_PRICE_OUTPUT_PER_MILLION_TOKENS=0

# Datenschutzfreundliche Standards für den lokalen Betrieb
LANGSMITH_TRACING=false
