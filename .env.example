# Local LLM
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_FAST_MODEL=qwen3.5:9b
OLLAMA_COMPLEX_MODEL=mistral-small3.2:24b
OLLAMA_REQUEST_TIMEOUT_SECONDS=180

# Embeddings
# Optional local path or already-cached Sentence Transformer; no download is attempted.
EMBEDDING_MODEL=

# Generation
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096
OLLAMA_THINK=false
AGENT_MAX_EXECUTION_SECONDS=90

# Application
APP_ENV=development
LOG_LEVEL=INFO
UI_SERVER_NAME=127.0.0.1
UI_SERVER_PORT=7860

# Local-first privacy defaults
CREWAI_DISABLE_TELEMETRY=true
CREWAI_TRACING_ENABLED=false
