# Local LLM
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_FAST_MODEL=qwen3.5:9b
OLLAMA_COMPLEX_MODEL=mistral-small3.2:24b
OLLAMA_REQUEST_TIMEOUT_SECONDS=180
# Demo default: verified_mcp skips the experimental Mistral crew for full assessments.
# Set to agentic to try the native Mistral/CrewAI path before its verified MCP fallback.
FULL_ASSESSMENT_MODE=verified_mcp

# Embeddings (v1.2): ollama for real use, hashing only for fast tests.
# Pull once: ollama pull qwen3-embedding:0.6b ; then build the index: novabank-index rebuild
EMBEDDING_BACKEND=ollama
EMBEDDING_MODEL=qwen3-embedding:0.6b
ROUTER_MODE=hybrid
# Optional override; default is <RUNTIME_DIR>/index
# INDEX_DIR=/absolute/path/to/index

# Generation
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096
OLLAMA_THINK=false
AGENT_MAX_EXECUTION_SECONDS=90
MCP_REQUEST_TIMEOUT_SECONDS=30
# Optional override; default is the operating system's per-user application state directory.
# RUNTIME_DIR=/absolute/path/to/local/runtime-state

# Application
APP_ENV=development
LOG_LEVEL=INFO
UI_SERVER_NAME=127.0.0.1
UI_SERVER_PORT=7860

# Local-first privacy defaults
CREWAI_DISABLE_TELEMETRY=true
CREWAI_TRACING_ENABLED=false
