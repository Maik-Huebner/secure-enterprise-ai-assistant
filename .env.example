# Local LLM
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_FAST_MODEL=qwen3.5:9b
OLLAMA_REQUEST_TIMEOUT_SECONDS=180

# Embeddings (v1.2): ollama for real use, hashing only for fast tests.
# Pull once: ollama pull qwen3-embedding:0.6b ; then build the index: novabank-index rebuild
EMBEDDING_BACKEND=ollama
EMBEDDING_MODEL=qwen3-embedding:0.6b
ROUTER_MODE=hybrid
# Optional override; default is <RUNTIME_DIR>/index
# INDEX_DIR=/absolute/path/to/index

# Generation
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024
LLM_CONTEXT_TOKENS=8192
ANSWER_MAX_ATTEMPTS=2
OLLAMA_THINK=false
MCP_REQUEST_TIMEOUT_SECONDS=30

# MCP transport (v1.5): stdio starts one subprocess per request; http talks to a separate
# Streamable HTTP server (start it with: novabank-mcp --transport http).
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=8001
MCP_SERVER_URL=http://127.0.0.1:8001/mcp
# Tokens for the MCP server have their own audience and a short lifetime.
MCP_AUDIENCE=novabank-mcp
MCP_TOKEN_TTL_MINUTES=5
# Optional override; default is the operating system's per-user application state directory.
# RUNTIME_DIR=/absolute/path/to/local/runtime-state

# API and security (v1.3)
# Required for the API. Generate once and keep it out of the repository:
#   python -c 'import secrets; print(secrets.token_urlsafe(48))'
JWT_SECRET=
JWT_TTL_MINUTES=15
API_HOST=127.0.0.1
API_PORT=8000
API_BASE_URL=http://127.0.0.1:8000
# Comma-free JSON list, e.g. ["https://intranet.example"]; empty = no cross-origin access.
CORS_ALLOWED_ORIGINS=[]
LOGIN_RATE_LIMIT_PER_MINUTE=5
CHAT_RATE_LIMIT_PER_MINUTE=20
API_DOCS_ENABLED=true
# Users: novabank-users add <name> --role sachbearbeiter|pruefer|admin [--team team-nord]

# Application
APP_ENV=development
LOG_LEVEL=INFO
UI_SERVER_NAME=127.0.0.1
UI_SERVER_PORT=7860

# Local-first privacy defaults
LANGSMITH_TRACING=false
